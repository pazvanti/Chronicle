# ==============================================================================
# Chronicle — Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Package Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ------------------------------------------------------------------------------
# 2. Build Outputs & Bundler Caches
# ------------------------------------------------------------------------------
dist/
dist-ssr/
dist-standalone/
*.tsbuildinfo
.vite/
.eslintcache
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 3. Tauri & Rust Compilation Artifacts
# Note: Source files in src-tauri/ (Cargo.toml, Cargo.lock, tauri.conf.json,
# src/, icons/, capabilities/) ARE tracked so desktop builds work.
# Only compiled artifacts, schemas, and debug symbols are ignored below.
# ------------------------------------------------------------------------------
src-tauri/target/
target/
src-tauri/gen/schemas/
**/*.rs.bk
Cargo.lock.bak
*.pdb
*.dSYM/
*.profraw
*.profdata

# ------------------------------------------------------------------------------
# 4. Binary Installers, Packages & Archives
# (Large compiled binaries should be published via GitHub Releases, not git history)
# ------------------------------------------------------------------------------
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.iso
*.dmg
*.exe
*.msi
*.deb
*.AppImage
*.apk
*.aab

# Staged desktop downloads (allow direct executables for GitHub Pages download buttons, ignore installers)
docs/downloads/*
!docs/downloads/.gitkeep
!docs/downloads/Chronicle.exe
!docs/downloads/Chronicle.dmg
!docs/downloads/Chronicle.zip
!docs/downloads/manifest.json

# ------------------------------------------------------------------------------
# 5. Local Environment Variables, Credentials & Code-Signing Certificates
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
*.pem
*.key
*.cert
*.cer
*.crt
*.pfx
*.p12
*.keystore
*.jks
*.sig

# ------------------------------------------------------------------------------
# 6. Scratch, Temporary & Test Artifacts
# ------------------------------------------------------------------------------
scratch/
temp/
tmp/
.tempmediaStorage/
test-results/
playwright-report/
blob-report/
edge-profile*/
chrome-profile*/
*.bak
*.tmp
*.orig
*.rej

# ------------------------------------------------------------------------------
# 7. Logs
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 8. Editor & IDE Settings
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
.cursor/
.fleet/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 9. Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Note: /docs (except docs/downloads/) is intentionally tracked as it serves
# the GitHub Pages presentation site and the in-browser Web Studio app (/docs/app/).
# ------------------------------------------------------------------------------
